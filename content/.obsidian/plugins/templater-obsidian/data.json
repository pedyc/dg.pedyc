{
  "data_version": 2,
  "command_timeout": 5,
  "templates_folder": "_templates",
  "templates_pairs": [],
  "trigger_on_file_creation_mode": "regex",
  "auto_jump_to_cursor": false,
  "jump_to_cursor_after_file_name": false,
  "shell_path": "",
  "user_scripts_folder": "_scripts",
  "folder_templates": [
    {
      "folder": "10-PROJECTS",
      "template": "_templates/template_project.md"
    }
  ],
  "file_templates": [
    {
      "regex": "/*/",
      "template": "_templates/template_new.md"
    }
  ],
  "syntax_highlighting": true,
  "syntax_highlighting_mobile": false,
  "enabled_templates_hotkeys": [],
  "startup_templates": [
    "_templates/template_startup.md"
  ],
  "intellisense_render": "1",
  "ignore_folders_on_creation": []
}