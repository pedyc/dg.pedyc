filters:
  and:
    - file.inFolder("30-RESOURCES/书单")
views:
  - type: kanban
    name: 阅读进度
    groupBy:
      property: read_status
      direction: ASC
    groupOrder:
      - 想读
      - 在读
      - 已读
      - 弃读
    order:
      - file.name
      - book_genre
      - rating
  - type: table
    name: 总表
    order:
      - file.name
      - book_genre
      - read_status
      - rating
      - book_format
      - pdf
    sort:
      - property: book_genre
        direction: ASC
      - property: file.name
        direction: ASC
