filters:
  or:
    - file.inFolder("30-RESOURCES")
    - file.inFolder("50-ZETTELCASTEN")
    - file.inFolder("20-AREAS")
    - file.inFolder("10-PROJECTS")
views:
  - type: table
    name: 缺 content-type
    filters:
      and:
        - content-type.isEmpty()
        - 'file.ext != ".excalidraw" '
    order:
      - file.name
      - file.folder
    sort:
      - property: file.folder
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: 缺 uid
    filters:
      and:
        - uid.isEmpty()
        - 'file.ext != ".excalidraw" '
    order:
      - file.name
      - content-type
      - file.folder
    sort:
      - property: file.folder
        direction: ASC
      - property: file.name
        direction: ASC
