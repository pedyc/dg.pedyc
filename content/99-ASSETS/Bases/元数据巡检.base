filters:
  or:
    - file.inFolder("30-RESOURCES")
    - file.inFolder("50-ZETTELCASTEN")
    - file.inFolder("20-AREAS")
    - file.inFolder("10-PROJECTS")
views:
  - type: table
    name: 非法 status
    filters:
      and:
        - note.status
        - note.status != "fleeting"
        - note.status != "active"
        - note.status != "archived"
    order:
      - file.name
      - status
      - content-type
      - file.folder
    sort:
      - property: file.folder
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: 缺 status
    filters:
      and:
        - note.status.isEmpty()
    order:
      - file.name
      - content-type
      - file.folder
    sort:
      - property: file.folder
        direction: ASC
      - property: file.name
        direction: ASC
