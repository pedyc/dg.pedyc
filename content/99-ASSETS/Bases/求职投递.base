filters:
  and:
    - file.inFolder("10-PROJECTS/P-Agent求职/投递记录")
views:
  - type: kanban
    name: 投递进度
    groupBy:
      property: note.apply_status
      direction: ASC
    groupOrder:
      - 投递
      - 笔试
      - 面试中
      - Offer
      - 已拒
    order:
      - file.name
      - note.company
      - note.next_action
  - type: table
    name: 总表
    order:
      - file.name
      - note.company
      - note.position
      - note.apply_status
      - note.interview_round
      - note.channel
      - note.applied_date
      - note.next_action
    sort:
      - property: note.applied_date
        direction: DESC
