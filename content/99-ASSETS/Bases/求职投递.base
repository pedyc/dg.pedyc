filters:
  and:
    - file.inFolder("10-PROJECTS/P-Agent求职/投递记录")
views:
  - type: kanban
    name: 投递进度
    groupBy:
      property: apply_status
      direction: ASC
    groupOrder:
      - 投递
      - 笔试
      - 面试中
      - Offer
      - 已拒
    order:
      - file.name
      - company
      - next_action
  - type: table
    name: 总表
    order:
      - file.name
      - company
      - position
      - apply_status
      - interview_round
      - channel
      - applied_date
      - next_action
    sort:
      - property: applied_date
        direction: DESC
