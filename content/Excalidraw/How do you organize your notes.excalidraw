			"locked": false,
			"fontSize": 20,
			"fontFamily": 1,
			"text": "Back in the days... in TheBrain I started off with a Content\nFirst approach, then gravitated to a Topic First setup",
			"textAlign": "right",
			"verticalAlign": "top",
			"containerId": "2cSF3uk98F0-1krTWPL1q",
			"originalText": "Back in the days... in TheBrain I started off with a Content\nFirst approach, then gravitated to a Topic First setup",
			"autoResize": true,
			"lineHeight": 1.25,
			"rawText": ""
		},
		{
			"type": "text",
			"version": 1212,
			"versionNonce": 1919956639,
