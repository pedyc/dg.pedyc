			"fontSize": 20,
			"fontFamily": 1,
			"text": "I don't really do research, Zettelkasten had\na bit too much friction for me, yet I find \nthe ethos of Zettelkasten very compelling.",
			"textAlign": "right",
			"verticalAlign": "top",
			"containerId": "tV7P4p7HUOK_seU-jxy2V",
			"originalText": "I don't really do research, Zettelkasten had\na bit too much friction for me, yet I find \nthe ethos of Zettelkasten very compelling.",
			"autoResize": true,
			"lineHeight": 1.25,
			"rawText": ""
		},
