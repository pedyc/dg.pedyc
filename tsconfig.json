{
  "compilerOptions": {
    "lib": ["esnext", "DOM", "DOM.Iterable"],
    "experimentalDecorators": true,
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "micromorph": ["./node_modules/micromorph/index.d.ts"],
      "remark-parse/lib": ["./node_modules/remark-parse/lib/index.d.ts"],
      "satori/wasm": ["./node_modules/satori/dist/index.d.ts"],
      "preact/src/jsx": ["./node_modules/preact/src/jsx.d.ts"]
    },
    "strict": true,
    "incremental": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": ["**/*.ts", "**/*.tsx", "./package.json", "esbuild.config.mjs"],
  "exclude": ["build/**/*.d.ts", "content"]
}
